APP_BASE_URL=https://accesos.tdemperu.com

# Fase 1 (ver docs/07 y 08): lectura del MISMO Google Sheet que ya usa el proyecto Apps Script
# (CONFIG.SPREADSHEETS.MAIN) via una cuenta de servicio de Google — nada de Supabase/Postgres,
# nada de una copia de los datos. GAS sigue siendo el unico que escribe.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# La clave privada del JSON de la cuenta de servicio, con los saltos de linea escapados como \n.
GOOGLE_SERVICE_ACCOUNT_KEY=

# "Flujo de atencion" (boton "Flujo de atencion" en la ficha): hoja EXTERNA, distinta a
# GOOGLE_SHEET_ID — hay que compartirla tambien con la cuenta de servicio (Lector alcanza).
# Mismos valores que CONFIG.FLUJO_ATENCION en GAS (Config.gs).
FLUJO_SPREADSHEET_ID=1mQ6O1Pyw4OMI9vypyxhFmk1euEZS2nRuokl8mE0Emow
FLUJO_SHEET_GID=1614489692

# Logo de marca (ver DEC-015 en GAS): se descarga desde Drive con la misma cuenta de servicio
# (scope drive.readonly ya incluido) — hay que compartir la carpeta de recursos del proyecto
# (CONFIG_MARCA.RECURSOS_FOLDER_ID en GAS) como Lector con esa misma cuenta, una sola vez.
# No hace falta ninguna variable de entorno nueva para esto.
